{% comment %}
  Renders a Purelane inline icon.

  The prototype repeats the same handful of paths inline dozens of times
  (leaf x12, check x15, arrow x6). One source here instead.

  Every icon is decorative by default: aria-hidden and focusable="false".
  Meaning is always carried by adjacent text, never by the glyph.

  Accepts:
  - icon: {String} leaf | arrow | check | star | plus  (required)
  - size: {Number} px, applied to width and height (optional)

  Usage:
  {% render 'purelane-icon', icon: 'leaf' %}
{% endcomment %}

{%- liquid
  assign stroke_common = 'fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"'
  if size
    assign dims = 'width="' | append: size | append: '" height="' | append: size | append: '"'
  else
    assign dims = ''
  endif
-%}

{%- case icon -%}
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" {{ stroke_common }} stroke-width="1.6" {{ dims }} aria-hidden="true" focusable="false">
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    </svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" {{ stroke_common }} stroke-width="2.2" {{ dims }} aria-hidden="true" focusable="false">
      <path d="M5 12h13m-5-6 6 6-6 6"/>
    </svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" {{ stroke_common }} stroke-width="2.4" {{ dims }} aria-hidden="true" focusable="false">
      <path d="m5 13 4 4L19 7"/>
    </svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" {{ dims }} aria-hidden="true" focusable="false">
      <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/>
    </svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" {{ stroke_common }} stroke-width="2.2" {{ dims }} aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14"/>
    </svg>
{%- endcase -%}
